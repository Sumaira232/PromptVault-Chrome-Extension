{
  "manifest_version": 3,
  "name": "PromptVault",
  "version": "1.0",
  "description": "Save and inject your favorite AI prompts.",

  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptVault"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}